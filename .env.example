# Template for local env. Copy to `.env` (or edit `.env` directly).
# `npm run gateway` loads `.env` automatically if present.
# Existing OS env vars are not overridden.

LOYALTY_HOST=127.0.0.1
LOYALTY_PORT=8787
LOYALTY_DATA_PATH=./data/node-snapshot.json

# Optional:
# LOYALTY_ADMIN_TOKEN=change-me
# LOYALTY_DISABLE_DEV=1
# NODE_ENV=production
